#!/bin/bash

python_script="$HOME/awards/awardswx.bin"
data_file="$HOME/awards/awards_v4e.db" 

# Гарантуємо, що іконка зникне при закритті або збої скрипту
cleanup() {
    xsetroot -name ""
}
trap cleanup EXIT INT TERM

xsetroot -name "    "

if [ ! -f "$data_file" ]; then
    dunstify -u critical "Файл $data_file не знайдено."
    exit 1
fi

"$python_script" -c "$data_file" 2>/dev/null &
