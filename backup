#!/usr/bin/env bash
set -Eeuo pipefail

############################
# КОЛЬОРИ
############################

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
RESET='\033[0m'

############################
# НАСТРОЙКИ
############################

DIRECTORY_KINGSTON="/mnt/chromeos/removable/KINGSTON/arch/now"
DIRECTORY_SDCARD="/mnt/chromeos/removable/SD Card"
DIRECTORY_SDCARD_NOW="$DIRECTORY_SDCARD/now"

RCLONE_NOW_CRYPT="now_crypt:"
RCLONE_GDRIVE_RAW="gdrive:дом/now"

WORK_DIR="$HOME/WORK"
DIRECTORY_BASE="$HOME/awards"
LOGFILE="/tmp/encryption.log"

RCLONE_OPTS=(
  --exclude "**/.fuse_hidden*"
  --exclude "**/*.~tmp*"
  --delete-before
  --stats "1s"
  -P
  --stats-one-line      
  --tpslimit 8            
  --drive-chunk-size 64M  
  --fast-list             
)

############################
# ЛОГИРОВАНИЕ
############################

log() {
  local msg="$(date '+%Y-%m-%d %H:%M:%S') $*"
  echo -e "${GREEN}${msg}${RESET}"
  echo "$msg" >> "$LOGFILE"
}

warn() {
  local msg="$(date '+%Y-%m-%d %H:%M:%S') [ПОПЕРЕДЖЕННЯ] $*"
  echo -e "${YELLOW}${msg}${RESET}"
  echo "$msg" >> "$LOGFILE"
}

die() {
  local msg="$(date '+%Y-%m-%d %H:%M:%S') [FATAL] $*"
  echo -e "${RED}${msg}${RESET}"
  echo "$msg" >> "$LOGFILE"
  exit 1
}

############################
# ГОЛОВНЕ МЕНЮ РЕЖИМІВ
############################

clear
echo -e "${CYAN}========================================${RESET}"
echo -e "${YELLOW}ОБЕРІТЬ РЕЖИМ РОБОТИ:${RESET}"
echo -e "  ${GREEN}1${RESET} - Повний цикл (транслітерація + шифрування на SD + відправка)"
echo -e "  ${GREEN}2${RESET} - Швидка дозаливка (лише відправка готових файлів з SD)"
echo -e "${CYAN}========================================${RESET}"

read -rp "$(echo -e "${BLUE}Ваш вибір [1/2]: ${RESET}")" MODE_CHOICE

if [[ "$MODE_CHOICE" == "2" ]]; then
  log "Обрано режим швидкої дозаливки. Пропускаємо транслітерацію та шифрування."
  [ -d "$DIRECTORY_SDCARD_NOW" ] || die "Директорія SD Card недоступна: $DIRECTORY_SDCARD_NOW"
  goto_step2=true
else
  goto_step2=false
fi

if [ "$goto_step2" = false ]; then

  ############################
  # ПЕРЕВІРКА ПОЧАТКОВИХ ДИРЕКТОРИЙ
  ############################

  DIRS=(
    "$DIRECTORY_SDCARD"
    "$DIRECTORY_SDCARD_NOW"
    "$DIRECTORY_BASE"
    "$WORK_DIR"
  )

  for dir in "${DIRS[@]}"; do
    [ -d "$dir" ] || die "Директорія недоступна: $dir"
  done

  ############################
  # 0. ФОРМУВАННЯ НАЗВ ФАЙЛІВ (ТРАНСЛІТЕРАЦІЯ)
  ############################

  transliterate() {
    python3 - "$1" <<'PY'
import os, sys, re

root = sys.argv[1]

translit = {
'А':'A','Б':'B','В':'V','Г':'G','Д':'D','Е':'E','Є':'E','Ж':'Zh','З':'Z','И':'Y','І':'I',
'Ї':'I','Й':'Y','К':'K','Л':'L','М':'M','Н':'N','О':'O','П':'P','Р':'R','С':'S','Т':'T',
'У':'U','Ф':'F','Х':'Kh','Ц':'Ts','Ч':'Ch','Ш':'Sh','Щ':'Shch','Ю':'Yu','Я':'Ya',
'а':'a','б':'b','в':'v','г':'g','д':'d','е':'e','є':'e','ж':'zh','з':'z','и':'y','і':'i',
'ї':'i','й':'y','к':'k','л':'l','м':'m','н':'n','о':'o','п':'p','р':'r','с':'s','т':'t',
'у':'u','ф':'f','х':'kh','ц':'ts','ч':'ch','ш':'sh','щ':'shch','ю':'yu','я':'ya','ь':'','ʼ':''
}

def safe_rename(old, new):
    if old == new:
        return
    if os.path.exists(new):
        return
    os.rename(old, new)

for dirpath, dirnames, filenames in os.walk(root, topdown=False):
    for name in filenames:
        newname = ''.join([translit.get(c,c) if ord(c)>127 else c for c in name])
        newname = re.sub(r'[ ,:;\'"<>?|]', '_', newname)
        safe_rename(os.path.join(dirpath,name), os.path.join(dirpath,newname))
    for name in dirnames:
        newname = ''.join([translit.get(c,c) if ord(c)>127 else c for c in name])
        newname = re.sub(r'[ ,:;\'"<>?|]', '_', newname)
        safe_rename(os.path.join(dirpath,name), os.path.join(dirpath,newname))
PY
  }

  log "0/ Формування назв файлів (транслітерація)..."
  transliterate "$DIRECTORY_BASE"
  transliterate "$WORK_DIR"

  ############################
  # 1. СИНХРОНІЗАЦІЯ ТА ШИФРУВАННЯ НА SD CARD
  ############################

  read -rp "$(echo -e "${YELLOW}Зашифрувати та скопіювати awards на SD Card? [y/N]: ${RESET}")" ans
  if [[ "$ans" =~ ^[yYаАдД]$ ]]; then
    log "1/ Синхронізація awards -> SD Card (now_crypt)..."
    rclone sync "$DIRECTORY_BASE" "$RCLONE_NOW_CRYPT/awards_arch" "${RCLONE_OPTS[@]}" 2>> "$LOGFILE"
  fi

  read -rp "$(echo -e "${YELLOW}Зашифрувати та скопіювати WORK на SD Card? [y/N]: ${RESET}")" ans
  if [[ "$ans" =~ ^[yYаАдД]$ ]]; then
    log "1/ Синхронізація WORK -> SD Card (now_crypt)..."
    rclone sync "$WORK_DIR" "$RCLONE_NOW_CRYPT/WORK" "${RCLONE_OPTS[@]}" 2>> "$LOGFILE"
  fi

fi

############################
# 2. ПЕРЕВІРКА ШЛЯХІВ ТА МЕНЮ ВІДПРАВКИ
############################

echo -e "\n${CYAN}------------------------------------------------${RESET}"
echo -e "${YELLOW}2/ Оберіть напрямок синхронізації зашифрованих даних:${RESET}"
echo -e "  ${GREEN}1${RESET} - Тільки в Google Drive"

KINGSTON_AVAILABLE=false
if [ -d "/mnt/chromeos/removable/KINGSTON" ]; then
  KINGSTON_AVAILABLE=true
  echo -e "  ${GREEN}2${RESET} - Тільки на KINGSTON"
  echo -e "  ${GREEN}3${RESET} - Глобально (Google Drive + KINGSTON)"
else
  echo -e "  ${RED}(Диск KINGSTON не підключено)${RESET}"
fi

echo -e "  ${GREEN}0${RESET} - Пропустити (залишити тільки на SD Card)"
echo -e "${CYAN}------------------------------------------------${RESET}"

read -rp "$(echo -e "${BLUE}Ваш вибір: ${RESET}")" target_ans

sync_to_gdrive() {
    log "Відправка SD Card -> Google Drive..."
    rclone sync "$DIRECTORY_SDCARD_NOW" "$RCLONE_GDRIVE_RAW" "${RCLONE_OPTS[@]}" 2>> "$LOGFILE"
}

sync_to_kingston() {
  if [ "$KINGSTON_AVAILABLE" = true ]; then
    log "Відправка SD Card -> KINGSTON..."
    rclone sync "$DIRECTORY_SDCARD_NOW" "$DIRECTORY_KINGSTON" "${RCLONE_OPTS[@]}" 2>> "$LOGFILE"
  else
    warn "Диск KINGSTON недоступний, пропускаємо."
  fi
}

case "$target_ans" in
  1)
    sync_to_gdrive
    ;;
  2)
    sync_to_king_ston_check=$( [[ "$KINGSTON_AVAILABLE" == true ]] && sync_to_kingston || warn "KINGSTON недоступний!" )
    ;;
  3)
    sync_to_gdrive
    sync_to_kingston
    ;;
  0)
    log "Синхронізацію на зовнішні носії пропущено за вашим вибором."
    ;;
  *)
    warn "Невірний вибір. Фінальну синхронізацію пропущено."
    ;;
esac

sync

echo ""
echo -e "${GREEN}========================================${RESET}"
echo -e "${GREEN}             ГОТОВО!                    ${RESET}"
echo -e "${GREEN}========================================${RESET}"
