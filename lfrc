# ---------- ПЕРЕГЛЯД ФАЙЛІВ (Right / l / д) ----------
cmd smart_view ${{
    if [ -d "$f" ]; then
        zoxide add "$PWD/$f" 2>/dev/null
        command lf -remote "send $id cd \"$f\""
        exit
    fi

    ext="${f##*.}"
    ext=$(printf "%s" "$ext" | tr '[:upper:]' '[:lower:]')

    case "$ext" in
        # Таблиці за стрілкою вправо відкриваємо у VisiData (vd)
        xls|xlsx|ods|csv|tsv)
            vd "$f"
            ;;
        zip|rar|7z|tar|gz|bz2|tgz)
            lf -remote "send $id extract"
            ;;
        gpg)
            clear
            out="${f%.gpg}"
            if gpg --decrypt -o "$out" "$f"; then
                command lf -remote "send $id reload"
            else
                rm -f "$out"
            fi
            read -r _
            ;;
        # Документи, PDF, коди, тексти — у пейджер
        pdf|fb2|epub|mobi|djvu|doc|docx|rtf|odt|py|sh|lua|c|cpp|h|conf|yaml|yml|json|md|txt|rc|rs|org)
            clear
            ~/.config/lf/readoc.sh "$f"
            ;;
        *)
            if file --mime-type -b "$f" | grep -q '^text/'; then
                clear
                ~/.config/lf/readoc.sh "$f"
            else
                xdg-open "$f" >/dev/null 2>&1 &
            fi
            ;;
    esac
}}

# Прив'язки
map <right> smart_view
map l smart_view
map д smart_view

# ---------- ЗОВНІШНЄ ВІДКРИТТЯ / РЕДАГУВАННЯ (enter) ----------
cmd open_external ${{
    if [ -d "$f" ]; then
        exit
    fi

    ext="${f##*.}"
    ext=$(printf "%s" "$ext" | tr '[:upper:]' '[:lower:]')
    
    case "$ext" in
        pdf|fb2|epub|mobi|djvu)
            zathura "$f" >/dev/null 2>&1 &
            ;;
        py|sh|lua|c|cpp|h|conf|yaml|yml|json|md|txt|rc|rs|org)
            nvim "$f"
            ;;
        doc|docx|odt|rtf)
            lowriter "$f" >/dev/null 2>&1 &
            ;;
        # Таблиці за натисканням Enter відкриваються в LibreOffice Calc
        xls|xlsx|ods|csv|tsv)
            localc "$f" >/dev/null 2>&1 &
            ;;
        *)
            if file --mime-type -b "$f" | grep -q '^text/'; then
                nvim "$f"
            else
                xdg-open "$f" >/dev/null 2>&1 &
            fi
            ;;
    esac
}}

map <enter> open_external


