# Конвертація архіву в інший формат
cmd arch_repack %{{
    printf "Новий формат (zip, 7z, tar.gz): "
    read format
    [ -z "$format" ] && exit

    newname="${f%.*}.$format"
    7z x "$f" -o/tmp/lf_repack_tmp >/dev/null &&
    7z a "$newname" /tmp/lf_repack_tmp/* &&
    rm -rf /tmp/lf_repack_tmp

    lf -remote "send $id reload"
}}
