## =====================
# Функція створення документа з шаблонів LibreOffice
# =====================
cmd create_from_template ${{
    TPL_DIR="$HOME/.config/libreoffice/4/user/template"
    if [ ! -d "$TPL_DIR" ]; then
        echo "Папка шаблонів не знайдена: $TPL_DIR"
        read -n 1 -s -r -p "Натисніть будь-яку клавішу..."
        exit 1
    fi
    
    TEMPLATE=$(find "$TPL_DIR" -maxdepth 1 -type f \( -name "*.ott" -o -name "*.ots" -o -name "*.otp" \) -printf "%f\n" | fzf --header="Виберіть шаблон")

    [ -z "$TEMPLATE" ] && exit 0
    echo -n "Введіть ім'я нового файлу (без розширення): "
    read FILENAME
    [ -z "$FILENAME" ] && exit 0
 
    EXT="${TEMPLATE##*.}"
    case "$EXT" in
        ott) NEW_EXT="odt" ;;
        ots) NEW_EXT="ods" ;;
        otp) NEW_EXT="odp" ;;
        *)   NEW_EXT="$EXT" ;;
    esac

    # Конвертация шаблона в обычный документ
    libreoffice --headless \
        --convert-to "$NEW_EXT" \
        --outdir "$(pwd)" \
        "$TPL_DIR/$TEMPLATE" >/dev/null 2>&1

    SRC_NAME="${TEMPLATE%.*}.$NEW_EXT"
    if [ -f "$SRC_NAME" ]; then
        mv "$SRC_NAME" "$FILENAME.$NEW_EXT"
    else
        echo "Помилка конвертації"
        read -n 1 -s -r -p "Натисніть будь-яку клавішу..."
        exit 1
    fi
        
    command lf -remote "send $id reload"
}}
map Ct create_from_template
map Се create_from_template

