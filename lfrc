cmd doc_to_pdf ${{
    filename=$(basename "$f")
    extension="${filename##*.}"
    ext_lower=$(echo "$extension" | tr '[:upper:]' '[:lower:]')
    
    case "$ext_lower" in
        docx|doc|odt)
            echo "Конвертація $filename у PDF..."
            libreoffice --headless --convert-to pdf "$f" &
            ;;
        *)
            echo "Помилка: цей формат ($extension) не підтримується для конвертації!"
            ;;
