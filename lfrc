# =====================
# BULK RENAME
# =====================
cmd bulk_rename ${{
    tmp_old=$(mktemp)
    tmp_new=$(mktemp)
    trap 'rm -f "$tmp_old" "$tmp_new"' EXIT

    if [ -n "$fx" ]; then
        echo "$fx" | tr ':' '\n' > "$tmp_old"
    else
        printf "%s\n" "$PWD"/* > "$tmp_old"
    fi

    while IFS= read -r line; do
        basename "$line"
    done < "$tmp_old" > "$tmp_new"

    ${EDITOR:-vi} "$tmp_new"

    old_cnt=$(wc -l < "$tmp_old")
    new_cnt=$(wc -l < "$tmp_new")

    if [ "$old_cnt" -eq "$new_cnt" ]; then
        exec 3<"$tmp_old"
        exec 4<"$tmp_new"

        while IFS= read -r old_path <&3 && IFS= read -r new_name <&4; do
            dir=$(dirname "$old_path")
            old_name=$(basename "$old_path")
            
            if [ "$old_name" != "$new_name" ] && [ -n "$new_name" ]; then
                mv -v "$old_path" "$dir/$new_name"
            fi
        done
        exec 3<&-
        exec 4<&-
    else
        echo "Помилка: Кількість рядків змінилася! Скасування."
        sleep 2
    fi

    command lf -remote "send $id reload"
}}
map A bulk_rename
map Ф bulk_rename

