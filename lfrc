# =====================
# TRASH 
# =====================
# помістити в корзину
cmd trash_put ${{
    TR="$HOME/.local/share/Trash"
    mkdir -p "$TR/files" "$TR/info"

    printf "%s\n" $fx | while IFS= read -r f; do
        [ -e "$f" ] || continue

        id="$(date +%s%N)"
        base="$(basename "$f")"
        real="$(readlink -f "$f")"

        mv -- "$f" "$TR/files/$id" || continue

        cat >"$TR/info/$id.trashinfo" <<EOF
Path=$real
Name=$base
Date=$(date -Iseconds)
EOF
    echo "Файл $f переміщено в кошик"
    done

    pkill -RTMIN+2 dwmblocks
    command lf -remote "send $id reload"
}}
map db trash_put
map ви trash_put

# --- trash restore fzf
cmd trash_restore ${{
    TR="$HOME/.local/share/Trash"

    list=$(
        for i in "$TR/info/"*.trashinfo; do
            [ -e "$i" ] || continue
            id="$(basename "$i" .trashinfo)"
            name="$(sed -n 's/^Name=//p' "$i")"
            path="$(sed -n 's/^Path=//p' "$i")"
            printf "%s | %s | %s\n" "$id" "$name" "$path"
        done
    )

    sel="$(printf "%s\n" "$list" | fzf -m --prompt='Відновити файл > ')"
    [ -z "$sel" ] && exit

    printf "%s\n" "$sel" | while IFS= read -r line; do
        id="${line%% |*}"
        info="$TR/info/$id.trashinfo"
        file="$TR/files/$id"

        dest="$(sed -n 's/^Path=//p' "$info")"
        mkdir -p "$(dirname "$dest")"
        mv -- "$file" "$dest"
        rm -f -- "$info"
    done

    pkill -RTMIN+2 dwmblocks
    command lf -remote "send $id reload"
}}
map dr trash_restore
map вк trash_restore

