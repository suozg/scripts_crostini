    fusermount -u -z "$HOME/.now_unencrypted" 2>/dev/null || true

    if [ -d "/mnt/chromeos/removable/SD Card/now" ]; then
        rclone mount --crypt-remote "/mnt/chromeos/removable/SD Card/now" now_crypt: "$HOME/.now_unencrypted" --dir-perms 0777 --daemon
