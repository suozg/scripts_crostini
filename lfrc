# =====================
cmd extract %{{
    set -f
    extract_dir=""
    case "$f" in
        *.tar.bz2) tar xjf "$f" ;;
        *.tar.gz)  tar xzf "$f" ;;
        *.tbz2)     tar xjf "$f" ;;
        *.tgz)      tar xzf "$f" ;;
        *.tar)      tar xf "$f" ;;
        *.bz2)      bunzip2 "$f" ;;
        *.gz)       gunzip "$f" ;;
        *.zip)
            # Пробуем bsdtar сначала (он лучше обрабатывает такие случаи)
            if command -v bsdtar >/dev/null 2>&1; then
                bsdtar -xf "$f"
            else
                # Если bsdtar нет, используем 7z с последующей обработкой
                7z x "$f"
                # Исправляем проблемные имена
                find . -name '*\\*' -exec bash -c '
                    for file; do
                        new=$(echo "$file" | sed "s/\\\\/\\//g")
                        mkdir -p "$(dirname "$new")"
                        mv -v "$file" "$new"
                    done
                ' _ {} +
            fi
            ;;
        *.rar)      unrar x "$f" ;;
        *.7z)       7z x "$f" ;;
        *.Z)        uncompress "$f" ;;
        *) echo "Невідомий формат архіву" ;;
    esac

    lf -remote "send $id reload"
}}
map xe extract
map чу extract

# Створення архіву з вибраних файлів
