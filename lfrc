# # ------ OPEN FILES ----------
cmd open_files ${{
    if [ -d "$f" ]; then
        zoxide add "$res"
        command lf -remote "send $id cd \"$f\""
        exit
    fi

    ext="${f##*.}"
    ext=$(printf "%s" "$ext" | tr '[:upper:]' '[:lower:]')
    
    xsetroot -name "    "
    
    case "$ext" in
        
        zip|rar|7z|tar|gz|bz2|tgz)
            lf -remote "send $id extract"
            ;;
        gpg)
            clear
            out="${f%.gpg}"
            if gpg --decrypt -o "$out" "$f"; then
                command lf -remote "send $id reload"
            else
                rm -f "$out"
            fi
            read -r _
            ;;
        pdf|fb2|epub|mobi|djvu)
            zathura "$f" >/dev/null 2>&1 &
            ;;
        py|sh|lua|c|cpp|h|conf|yaml|yml|json|md|txt|rc|rs)
            nvim "$f"
            ;;
        csv|tsv)
            vd "$f"
            ;;
        *)
            if file --mime-type -b "$f" | grep -q '^text/'; then
                nvim "$f"
            else
                xdg-open "$f" >/dev/null 2>&1 &
            fi
            ;;
    esac
}}
map l open_files
map д open_files
map <right> open_files
map <enter> open_files

