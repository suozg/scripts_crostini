cmd all_doc_to_pdf ${{
    echo "Початок конвертації всіх документів у папці..."
    count=0
    # Цикл по всіх файлах у поточній директорії
    for file in *; do
        # Перевіряємо, чи це дійсно файл, а не папка
        if [ -f "$file" ]; then
            # Отримуємо розширення в нижньому регістрі
            ext="${file##*.}"
            ext_lower=$(echo "$ext" | tr '[:upper:]' '[:lower:]')
            
            case "$ext_lower" in
                docx|doc|odt)
                    echo "Конвертується: $file"
                    libreoffice --headless --convert-to pdf "$file"
                    count=$((count + 1))
                    ;;
            esac
        fi
    done
    
    if [ "$count" -gt 0 ]; then
        echo "Готово! Успішно конвертовано файлів: $count"
    else
        echo "У цій папці не знайдено файлів docx, doc або odt."
    fi
}}

