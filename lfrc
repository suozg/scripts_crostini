## =====================
# Функція створення документа з шаблонів LibreOffice або Neovim
# =====================
cmd create_from_template ${{
    LO_TPL_DIR="$HOME/.config/libreoffice/4/user/template"
    NV_TPL_DIR="$HOME/.config/nvim/templates"
    
    export FZF_DEFAULT_OPTS="--layout=reverse --border=rounded --margin=5%,10% --height=80% --info=inline"

    # Збираємо шаблони LibreOffice (якщо папка існує)
    LO_LIST=""
    if [ -d "$LO_TPL_DIR" ]; then
        LO_LIST=$(find "$LO_TPL_DIR" -maxdepth 1 -type f \( -name "*.ott" -o -name "*.ots" -o -name "*.otp" \) -printf "[LibreOffice] %f\n")
    fi

    # Збираємо шаблони Neovim (якщо папка існує)
    NV_LIST=""
    if [ -d "$NV_TPL_DIR" ]; then
        NV_LIST=$(find "$NV_TPL_DIR" -maxdepth 1 -type f -printf "[Neovim] %f\n")
    fi

    # Об'єднуємо списки та відправляємо у fzf
    SELECTED=$(printf "%s\n%s" "${LO_LIST}" "${NV_LIST}" | sed '/^\s*$/d' | fzf --header="Виберіть шаблон")

    [ -z "$SELECTED" ] && exit 0

    # Розділяємо тип шаблону та власне ім'я файлу
    TYPE=$(echo "$SELECTED" | awk '{print $1}')
    TEMPLATE=$(echo "$SELECTED" | cut -d' ' -f2-)

    echo -n "Введіть ім'я нового файлу (без розширення): "
    read FILENAME
    [ -z "$FILENAME" ] && exit 0

    case "$TYPE" in
        "[LibreOffice]")
            EXT="${TEMPLATE##*.}"
            case "$EXT" in
                ott) NEW_EXT="odt" ;;
                ots) NEW_EXT="ods" ;;
                otp) NEW_EXT="odp" ;;
                *)   NEW_EXT="$EXT" ;;
            esac

            libreoffice --headless \
                --convert-to "$NEW_EXT" \
                --outdir "$(pwd)" \
                "$LO_TPL_DIR/$TEMPLATE" >/dev/null 2>&1

            SRC_NAME="${TEMPLATE%.*}.$NEW_EXT"
            if [ -f "$SRC_NAME" ]; then
                mv "$SRC_NAME" "$FILENAME.$NEW_EXT"
            else
                echo "Помилка конвертації LibreOffice"
                read -n 1 -s -r -p "Натисніть будь-яку клавішу..."
                exit 1
            fi
            ;;

        "[Neovim]")
            # Отримуємо оригінальне розширення шаблону nvim
            NV_EXT="${TEMPLATE##*.}"
            # Просто копіюємо шаблон у поточну папку з новим ім'ям
            cp "$NV_TPL_DIR/$TEMPLATE" "$(pwd)/$FILENAME.$NV_EXT"
            
            # Відкриваємо створений файл у Neovim всередині lf
            # (lf автоматично оновить екран після закриття редактора)
            nvim "$FILENAME.$NV_EXT"
            ;;
    esac
        
    command lf -remote "send $id reload"
}}
map Ct create_from_template
map Се create_from_template


