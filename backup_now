#!/usr/bin/env bash
set -Eeuo pipefail

############################
# НАСТРОЙКИ
############################

DIRECTORY_KINGSTON="/mnt/chromeos/removable/KINGSTON/arch/now"
DIRECTORY_SDCARD="/mnt/chromeos/removable/SD Card"
DIRECTORY_SDCARD_NOW="$DIRECTORY_SDCARD/now"
DIRECTORY_SDCARD_BASE="$DIRECTORY_SDCARD_NOW/awards_arch"
GOOGLE_DRIVE_DIR="/mnt/chromeos/GoogleDrive/SharedWithMe/168/now"
WORK_DIR="$HOME/WORK"
DIRECTORY_BASE="$HOME/awards"
LOGFILE="/tmp/encryption.log"

############################
# ЛОГИРОВАНИЕ
############################

exec > >(tee -a "$LOGFILE") 2>&1

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') $*"
}

die() {
  log "FATAL: $*"
  exit 1
}

############################
# ПРОВЕРКА ДИРЕКТОРИЙ
############################

DIRS=(
  "$DIRECTORY_SDCARD"
  "$DIRECTORY_SDCARD_NOW"
  "$DIRECTORY_BASE"
  "$DIRECTORY_SDCARD_BASE"
  "$GOOGLE_DRIVE_DIR"
  "$WORK_DIR"
)

for dir in "${DIRS[@]}"; do
  [ -d "$dir" ] || die "Директорія недоступна: $dir"
done

############################
#  РОЗКЛАДКА КЛАВІАТУРИ
############################
KEYB=""
keyblayout() {
    # Отримуємо поточну розкладку миттєво через xkb-switch
    local current_short
    current_short=$(xkb-switch -p)
    
    [[ "$current_short" == "us" ]] && KEYB="🗽US" || KEYB="🌻UA"
}


############################
# ТРАНСЛИТЕРАЦИЯ
############################

transliterate() {
  python3 - "$1" <<'PY'
import os, sys, re

root = sys.argv[1]

translit = {
'А':'A','Б':'B','В':'V','Г':'G','Д':'D','Е':'E','Є':'E','Ж':'Zh','З':'Z','И':'Y','І':'I',
'Ї':'I','Й':'Y','К':'K','Л':'L','М':'M','Н':'N','О':'O','П':'P','Р':'R','С':'S','Т':'T',
'У':'U','Ф':'F','Х':'Kh','Ц':'Ts','Ч':'Ch','Ш':'Sh','Щ':'Shch','Ю':'Yu','Я':'Ya',
'а':'a','б':'b','в':'v','г':'g','д':'d','е':'e','є':'e','ж':'zh','з':'z','и':'y','і':'i',
'ї':'i','й':'y','к':'k','л':'l','м':'m','н':'n','о':'o','п':'p','р':'r','с':'s','т':'t',
'у':'u','ф':'f','х':'kh','ц':'ts','ч':'ch','ш':'sh','щ':'shch','ю':'yu','я':'ya','ь':'','ʼ':''
}

def safe_rename(old, new):
    if old == new:
        return
    if os.path.exists(new):
        return
    os.rename(old, new)

for dirpath, dirnames, filenames in os.walk(root, topdown=False):
    for name in filenames:
        newname = ''.join([translit.get(c,c) if ord(c)>127 else c for c in name])
        newname = re.sub(r'[ ,:;\'"<>?|]', '_', newname)
        safe_rename(os.path.join(dirpath,name), os.path.join(dirpath,newname))
    for name in dirnames:
        newname = ''.join([translit.get(c,c) if ord(c)>127 else c for c in name])
        newname = re.sub(r'[ ,:;\'"<>?|]', '_', newname)
        safe_rename(os.path.join(dirpath,name), os.path.join(dirpath,newname))
PY
}

log "Виправлення назв файлів..."
transliterate "$DIRECTORY_SDCARD"
transliterate "$WORK_DIR"

############################
# ПАРОЛЬ
############################

if [ -z "${PASSPHRASE:-}" ]; then
  while true; do
    keyblayout
    read -rsp "Пароль ($KEYB): " PASSPHRASE; echo
    read -rsp "Підтвердження ($KEYB): " CONFIRM; echo
    [[ "$PASSPHRASE" == "$CONFIRM" ]] && break
    log "Паролі не співпали ($KEYB)"
  done
fi

############################
# RSYNC 
############################

# Синхронізація з явним ігноруванням .fuse_hidden та дозволом на видалення папок
rsync_clean_sync() {
  src="$1"
  dst="$2"

  [ -n "$src" ] && [ -n "$dst" ] || die "rsync_clean: пустий шлях"
  [ -d "$src" ] || die "rsync_clean: src не існує: $src"

  mkdir -p "$dst" || die "не можу створити директорію: $dst"
  sleep 1

  # Створюємо тимчасовий файл списку
  local file_list
  file_list=$(mktemp /tmp/rsync_files.XXXXXX)

  log "Створення списку файлів для: $src (без .fuse_hidden*)"
  # Використовуємо find для генерації списку, явно виключаючи .fuse_hidden*
  find "$src" -not -name ".fuse_hidden*" -printf "%P\n" > "$file_list"

  if [ ! -s "$file_list" ]; then
      log "INFO: Сsource порожній або містить лише .fuse_hidden*, нічого копіювати"
      rm -f "$file_list"
      return 0
  fi

  # Запускаємо rsync, використовуючи список.
  # rsync копіює ТІЛЬКИ те, що в списку, і тепер `--delete` працює коректно,
  # бо rsync бачить, які файли були видалені, і не бачить .fuse_hidden як перешкоду.
  log "Синхронізація: $src → $dst"
  rsync -rptDo \
    --progress \
    --delete \
    --delete-after \
    --itemize-changes \
    --files-from="$file_list" \
    "$src/" "$dst/" \
    2>&1 | tee -a "$LOGFILE"

  # Очищуємо тимчасовий файл
  rm -f "$file_list"
}


############################
# КОПИРОВАНИЕ
############################

read -rp "Копіювати awards? [y/N]: " ans
if [[ "$ans" =~ ^[yYаАдД]$ ]]; then
  log "Копіювання awards"
  rsync_clean_sync "$DIRECTORY_BASE" "$DIRECTORY_SDCARD_BASE" # ОНОВЛЕНО
fi

read -rp "Копіювати WORK? [y/N]: " ans
if [[ "$ans" =~ ^[yYаАдД]$ ]]; then
  log "Копіювання WORK"
  rsync_clean_sync "$WORK_DIR" "$DIRECTORY_SDCARD_NOW/WORK" # ОНОВЛЕНО
fi


############################
# ШИФРОВАНИЕ
############################

log "Шифрування..."

while IFS= read -r -d '' file; do

  log "Шифрую: $file"

  if gpg --batch --yes \
        --pinentry-mode loopback \
        --passphrase "$PASSPHRASE" \
        -c "$file"; then

    if [ -s "$file.gpg" ]; then
      rm -f "$file"
      log "OK: $file"
    else
      log "ERROR: порожній файл $file.gpg"
    fi

  else
    log "ERROR: gpg failed $file"
  fi

done < <(
  find "$DIRECTORY_SDCARD_NOW" -type f \
    ! -name "*.gpg" \
    ! -path "$DIRECTORY_SDCARD_BASE/*" \
    ! -path "*/STATYSTYKA/NN/*" \
    ! -name ".fuse_hidden*" \
    -print0
)

unset PASSPHRASE


############################
# СИНХРОНИЗАЦИЯ (SD -> Drive/Kingston)
############################

# Використовуємо прямий rsync без --exclude, щоб скрипт ВИДАЛЯВ .fuse_hidden з приймачів

log "Sync → Google Drive"
mkdir -p "$GOOGLE_DRIVE_DIR"
sleep 1
rsync -rptDo --progress --delete --delete-after --itemize-changes "$DIRECTORY_SDCARD_NOW/" "$GOOGLE_DRIVE_DIR/" 2>&1 | tee -a "$LOGFILE"

if [ -d "$DIRECTORY_KINGSTON" ]; then
  log "Sync → KINGSTON"
  mkdir -p "$DIRECTORY_KINGSTON"
  sleep 1
  rsync -rptDo --progress --delete --delete-after --itemize-changes "$DIRECTORY_SDCARD_NOW/" "$DIRECTORY_KINGSTON/" 2>&1 | tee -a "$LOGFILE"
fi

sync

log ""
log "ГОТОВО"
