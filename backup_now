#!/usr/bin/env bash
set -Eeuo pipefail

############################
# НАСТРОЙКИ
############################

DIRECTORY_KINGSTON="/mnt/chromeos/removable/KINGSTON/arch/now"
DIRECTORY_SDCARD="/mnt/chromeos/removable/SD Card"
DIRECTORY_SDCARD_NOW="$DIRECTORY_SDCARD/now"
DIRECTORY_SDCARD_BASE="$DIRECTORY_SDCARD_NOW/awards_arch"
GOOGLE_DRIVE_DIR="/mnt/chromeos/GoogleDrive/SharedWithMe/168/now"
WORK_DIR="$HOME/WORK"
DIRECTORY_BASE="$HOME/awards"
LOGFILE="/tmp/encryption.log"

############################
# ЛОГИРОВАНИЕ
############################

exec > >(tee -a "$LOGFILE") 2>&1

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') $*"
}

die() {
  log "FATAL: $*"
  exit 1
}



############################
# СИНХРОНІЗАЦІЯ
############################

rsync_clean_sync() {
    local src="$1"
    local dst="$2"

    [ -n "$src" ] && [ -n "$dst" ] || die "rsync_clean: пустий шлях"
    [ -d "$src" ] || die "rsync_clean: src не існує: $src"

    mkdir -p "$dst" || die "Не можу створити директорію: $dst"

    local file_list
    file_list=$(mktemp /tmp/rsync_files.XXXXXX)

    trap 'rm -f "$file_list"' RETURN

    log "Створення списку файлів для: $src (без .fuse_hidden*)"

    find "$src" \
        ! -name ".fuse_hidden*" \
        -printf "%P\n" >"$file_list"

    if [ ! -s "$file_list" ]; then
        log "INFO: Немає файлів для синхронізації"
        return 0
    fi

    log "Очищення застарілих файлів у приймачі..."

    while IFS= read -r -d '' dst_file; do
        local rel="${dst_file#$dst/}"

        if [[ "$rel" != .fuse_hidden* ]] &&
           [ ! -e "$src/$rel" ]; then
            rm -rf -- "$dst_file"
        fi
    done < <(find "$dst" -mindepth 1 -print0)

    local total_files current=0
    total_files=$(wc -l < "$file_list")

    log "Синхронізація: $src → $dst"

    while IFS= read -r rel_path; do
        ((++current))

        local display_path="$rel_path"

        if [ ${#display_path} -gt 60 ]; then
            display_path="...${display_path: -57}"
        fi

        if [ -d "$src/$rel_path" ]; then
            mkdir -p "$dst/$rel_path"
        continue
        fi

        mkdir -p "$(dirname "$dst/$rel_path")"

        output=$(
            rsync -rptDo \
                --out-format="%n" \
                "$src/$rel_path" \
                "$dst/$rel_path" \
                2>&1
        )

        status=$?

        printf '%s\n' "$output" >>"$LOGFILE"

        (( status == 0 )) || die "Помилка копіювання: $rel_path"

        if [[ -n "$output" ]]; then
            printf "\r\033[K[%d/%d] %s" \
                "$current" "$total_files" "$display_path"
        fi

    done <"$file_list"

    printf "\r\033[K[%d/%d] Готово\n" \
        "$total_files" "$total_files"
}

############################
# МЕНЮ ТА ПЕРЕВІРКА KINGSTON
############################

# Перевіряємо, чи підключено KINGSTON (чи існує точка монтування/директорія)
if [ -d "/mnt/chromeos/removable/KINGSTON" ]; then
  echo "------------------------------------------------"
  echo "Знайдено диск KINGSTON! Оберіть дію:"
  echo "1 - Скопіювати SD Card -> KINGSTON (пряма синхронізація)"
  echo "2 - Оновити бекап глобально (повний скрипт з шифруванням)"
  echo "------------------------------------------------"
  read -rp "Ваш вибір [1-2]: " menu_ans

  if [[ "$menu_ans" == "1" ]]; then
    log "Запуск синхронізації SD Card ($DIRECTORY_SDCARD_NOW) -> KINGSTON ($DIRECTORY_KINGSTON)..."
    
    # Перевіряємо базову наявність SD перед копіюванням
    [ -d "$DIRECTORY_SDCARD_NOW" ] || die "Директорія недоступна: $DIRECTORY_SDCARD_NOW"
    
    rsync_clean_sync "$DIRECTORY_SDCARD_NOW" "$DIRECTORY_KINGSTON"
    sync
    log "Синхронізація SD -> KINGSTON завершена успішно!"
    exit 0
  elif [[ "$menu_ans" == "2" ]]; then
    log "Обрано глобальне оновлення. Переходимо до виконання скрипта..."
  else
    die "Невірний вибір. Вихід."
  fi
else
  log "Диск KINGSTON не знайдено. Автоматично запускається глобальне оновлення..."

fi

############################
# ПРОВЕРКА ДИРЕКТОРИЙ (БЕЗ KINGSTON)
############################

# Директорію KINGSTON звідси прибрано, щоб скрипт не падав, якщо диска немає
DIRS=(
  "$DIRECTORY_SDCARD"
  "$DIRECTORY_SDCARD_NOW"
  "$DIRECTORY_BASE"
  "$DIRECTORY_SDCARD_BASE"
  "$GOOGLE_DRIVE_DIR"
  "$WORK_DIR"
)

for dir in "${DIRS[@]}"; do
  [ -d "$dir" ] || die "Директорія недоступна: $dir"
done

############################
#  РОЗКЛАДКА КЛАВІАТУРИ
############################
KEYB=""
keyblayout() {
    local current_short
    current_short=$(xkb-switch -p)
    
    [[ "$current_short" == "us" ]] && KEYB="🗽US" || KEYB="🌻UA"
}

############################
# ТРАНСЛИТЕРАЦИЯ
############################

transliterate() {
  python3 - "$1" <<'PY'
import os, sys, re

root = sys.argv[1]

translit = {
'А':'A','Б':'B','В':'V','Г':'G','Д':'D','Е':'E','Є':'E','Ж':'Zh','З':'Z','И':'Y','І':'I',
'Ї':'I','Й':'Y','К':'K','Л':'L','М':'M','Н':'N','О':'O','П':'P','Р':'R','С':'S','Т':'T',
'У':'U','Ф':'F','Х':'Kh','Ц':'Ts','Ч':'Ch','Ш':'Sh','Щ':'Shch','Ю':'Yu','Я':'Ya',
'а':'a','б':'b','в':'v','г':'g','д':'d','е':'e','є':'e','ж':'zh','з':'z','и':'y','і':'i',
'ї':'i','й':'y','к':'k','л':'l','м':'m','н':'n','о':'o','п':'p','р':'r','с':'s','т':'t',
'у':'u','ф':'f','х':'kh','ц':'ts','ч':'ch','ш':'sh','щ':'shch','ю':'yu','я':'ya','ь':'','ʼ':''
}

def safe_rename(old, new):
    if old == new:
        return
    if os.path.exists(new):
        return
    os.rename(old, new)

for dirpath, dirnames, filenames in os.walk(root, topdown=False):
    for name in filenames:
        newname = ''.join([translit.get(c,c) if ord(c)>127 else c for c in name])
        newname = re.sub(r'[ ,:;\'"<>?|]', '_', newname)
        safe_rename(os.path.join(dirpath,name), os.path.join(dirpath,newname))
    for name in dirnames:
        newname = ''.join([translit.get(c,c) if ord(c)>127 else c for c in name])
        newname = re.sub(r'[ ,:;\'"<>?|]', '_', newname)
        safe_rename(os.path.join(dirpath,name), os.path.join(dirpath,newname))
PY
}

log "Виправлення назв файлів..."
transliterate "$DIRECTORY_SDCARD"
transliterate "$WORK_DIR"

############################
# ПАРОЛЬ
############################

if [ -z "${PASSPHRASE:-}" ]; then
  while true; do
    keyblayout
    read -rsp "Пароль ($KEYB): " PASSPHRASE; echo
    read -rsp "Підтвердження ($KEYB): " CONFIRM; echo
    [[ "$PASSPHRASE" == "$CONFIRM" ]] && break
    log "Паролі не співпали ($KEYB)"
  done
fi

############################
# КОПИРОВАНИЕ
############################

read -rp "Копіювати awards? [y/N]: " ans
if [[ "$ans" =~ ^[yYаАдД]$ ]]; then
  log "Копіювання awards"
  rsync_clean_sync "$DIRECTORY_BASE" "$DIRECTORY_SDCARD_BASE"
fi

read -rp "Копіювати WORK? [y/N]: " ans
if [[ "$ans" =~ ^[yYаАдД]$ ]]; then
  log "Копіювання WORK"
  rsync_clean_sync "$WORK_DIR" "$DIRECTORY_SDCARD_NOW/WORK"
fi

############################
# ШИФРОВАНИЕ
############################

log "Шифрування..."

while IFS= read -r -d '' file; do

  log "Шифрую: $file"

  if gpg --batch --yes \
        --pinentry-mode loopback \
        --passphrase "$PASSPHRASE" \
        -c "$file"; then

    if [ -s "$file.gpg" ]; then
      rm -f "$file"
      log "OK: $file"
    else
      log "ERROR: порожній файл $file.gpg"
    fi

  else
    log "ERROR: gpg failed $file"
  fi

done < <(
  find "$DIRECTORY_SDCARD_NOW" -type f \
    ! -name "*.gpg" \
    ! -path "$DIRECTORY_SDCARD_BASE/*" \
    ! -path "*/STATYSTYKA/NN/*" \
    ! -name ".fuse_hidden*" \
    -print0
)

unset PASSPHRASE

############################
# СИНХРОНИЗАЦИЯ (SD -> Drive/Kingston)
############################

log "Sync → Google Drive"
mkdir -p "$GOOGLE_DRIVE_DIR"
sleep 1
rsync -rptDo --progress --delete --delete-after --itemize-changes "$DIRECTORY_SDCARD_NOW/" "$GOOGLE_DRIVE_DIR/" 2>&1 | tee -a "$LOGFILE"

if [ -d "$DIRECTORY_KINGSTON" ]; then
  log "Sync → KINGSTON"
  mkdir -p "$DIRECTORY_KINGSTON"
  sleep 1
  rsync -rptDo --progress --delete --delete-after --itemize-changes "$DIRECTORY_SDCARD_NOW/" "$DIRECTORY_KINGSTON/" 2>&1 | tee -a "$LOGFILE"
fi

sync

log ""
log "ГОТОВО"
