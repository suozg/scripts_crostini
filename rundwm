#!/bin/bash

LOCK="/tmp/rundwm.lock"

if [ -f "$LOCK" ] && kill -0 "$(cat "$LOCK")" 2>/dev/null; then
    exit 0
fi

echo $$ > "$LOCK"

sudo mountpoint -q /tmp || \
sudo mount -t tmpfs -o mode=1777,size=1G tmpfs /tmp

sudo mkdir -p /tmp/.X11-unix
sudo chown root:root /tmp/.X11-unix
sudo chmod 1777 /tmp/.X11-unix

touch /tmp/dwm-radio-status

export GDK_BACKEND=x11
export QT_QPA_PLATFORM=xcb

# Зберігаємо PID (ідентифікатор процесу) Xephyr
XEPHYR_PID=""

if ! pgrep -f "Xephyr :20" > /dev/null; then
    Xephyr -br -fullscreen -resizeable :20 &
    XEPHYR_PID=$!
else
    # Якщо Xephyr вже запущений, виходимо
    exit
fi

while ! xdpyinfo -display :20 > /dev/null 2>&1; do
    sleep 1
done

# Функція очищення пам'яті
cleanup_memory() {
    sync
    echo "Cleaning up temporary files..."
    rm -f /tmp/dwm-radio-status 2>/dev/null
    find /tmp -maxdepth 1 -user "$(whoami)" -not -name ".X11-unix" -exec rm -rf {} + 2>/dev/null
    rm -f "$LOCK"
}

# Функція для вбивства всіх фонових процесів
kill_background() {
    echo "Stopping background processes on :20..."

    pkill -f mpv || true
    pkill -f mpvdwm || true
    pkill -f dunst || true

    for PID in "${BACKGROUND_PIDS[@]}"; do
        kill -TERM "$PID" 2>/dev/null
    done

    sleep 2

    for PID in "${BACKGROUND_PIDS[@]}"; do
        # якщо процесс все ще існує 
        if kill -0 "$PID" 2>/dev/null; then
            kill -KILL "$PID" 2>/dev/null
            echo "!!! killed $PID"
        fi
    done

    if [ -n "$XEPHYR_PID" ]; then
        kill -TERM "$XEPHYR_PID" 2>/dev/null
        wait "$XEPHYR_PID" 2>/dev/null
    fi

    cleanup_memory
}

# Створюємо масив, щоб зберігати PID фонових процесів
BACKGROUND_PIDS=()

# Встановлюємо пастку: при будь-якому виході зі скрипта (EXIT) викликати kill_background
trap kill_background EXIT

# run dunst
DISPLAY=:20 dunst &
BACKGROUND_PIDS+=($!)

# run mpvd
mkdir -p /tmp
echo "📻 Radio (Alt+R)" > /tmp/dwm-radio-status
DISPLAY=:20 /usr/local/bin/mpvdwm &
BACKGROUND_PIDS+=($!)

# Запускаємо демон буфера обміну на вкладеному дисплеї та зберігаємо його PID
DISPLAY=:20 clipmenud >/dev/null 2>&1 &
BACKGROUND_PIDS+=($!)

# Запускаємо статус-бар dwm та зберігаємо його PID
DISPLAY=:20 dwmblocks >/dev/null 2>&1 &
BACKGROUND_PIDS+=($!)

# Запускаємо сам dwm (ця команда блокує виконання скрипта)
# Якщо dwm завершиться, виконання автоматично перейде до trap EXIT,
# який запустить kill_background() і все зупинить.
echo "Starting DWM on :20..."
DISPLAY=:20 dwm


